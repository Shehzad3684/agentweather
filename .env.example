# ==============================================================================
# AgentWeather Environment Variables Configuration
# ==============================================================================

# Hopsworks Feature Store and Model Registry
# Get free API key at: https://app.hopsworks.ai
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=agentweather

# OpenWeatherMap API (Live Weather Ingestion)
# Get free API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# AQICN API (Live Air Quality Pollutants Ingestion)
# Get free API key token at: https://aqicn.org/data-platform/token/
AQICN_API_KEY=your_aqicn_api_key_here

# Groq Cloud API (LangGraph LLM Agent Layer - llama-3.3-70b-versatile)
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# GitHub Personal Access Token (for Drift Agent to dispatch training_pipeline.yml)
# Required scopes: repo, workflow
# Generate at: https://github.com/settings/tokens
GH_PAT=your_github_personal_access_token_here
GITHUB_REPOSITORY=your_username/agentweather

# Target City Configuration (Default: London, UK)
CITY_NAME=London
CITY_LAT=51.5074
CITY_LON=-0.1278
